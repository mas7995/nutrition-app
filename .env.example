# ─────────────────────────────────────────────────────────────
# Client app (Expo) — these are PUBLIC and shipped in the bundle.
# The anon key is safe to expose because Row Level Security is the
# real access control. Never put service-role or food-API keys here.
# ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─────────────────────────────────────────────────────────────
# Server only — Supabase Edge Function env (lookup-food).
# These NEVER ship in the app bundle. Set them with:
#   supabase secrets set NUTRITIONIX_APP_ID=... NUTRITIONIX_APP_KEY=...
# Listed here only to document what the function expects.
# ─────────────────────────────────────────────────────────────
# NUTRITIONIX_APP_ID=your-nutritionix-app-id
# NUTRITIONIX_APP_KEY=your-nutritionix-app-key
